<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the window's content frame. System-bar insets are applied per child in
     MainActivity so the loading overlay can stay full-screen and line up with the splash. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- The WebView is added in code so it can be rebuilt after a renderer crash. -->
        <FrameLayout
            android:id="@+id/web_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/page_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:contentDescription="@string/cd_loading"
        android:indeterminate="false"
        android:layoutDirection="rtl"
        android:visibility="gone"
        app:indicatorColor="@color/fm_amber_bright"
        app:trackColor="@android:color/transparent"
        app:trackThickness="3dp" />

    <include
        android:id="@+id/error_view"
        layout="@layout/view_page_error"
        android:visibility="gone" />

    <!-- Loading screen: picks up exactly where the system splash leaves off. -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fm_bg_dark"
        android:clickable="true"
        android:contentDescription="@string/cd_loading"
        android:focusable="true">

        <ImageView
            android:id="@+id/loading_disc"
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_gramophone_disc" />

        <ImageView
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_gramophone_arm" />

    </FrameLayout>

    <ir.fm24.app.ui.StatusBanner
        android:id="@+id/status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp" />

</merge>

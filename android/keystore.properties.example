# Release signing for both store flavors.
# Copy this file to keystore.properties (git-ignored) and fill in your own values.
# storeFile is relative to this android/ folder; keep the keystore in keystore/ (also ignored).
storeFile=keystore/your-release-key.jks
storePassword=CHANGE_ME
keyAlias=your-key-alias
keyPassword=CHANGE_ME
